# Copy to .env and fill in the real password.
# Never commit .env.

# Tailscale IP of Postgres. Inside this Docker env, 127.0.0.1 is THIS
# container, not the host — use the 100.x address.
DATABASE_URL=postgresql://caleb:CHANGE_ME@100.74.101.82:5432/field_ai

# Where .wav files land.
# Cursor docker: a writable folder (e.g. ./audio).
# Host compose: docker-compose.yml forces AUDIO_DIR=/audio and persists
# files on the host at ./data/audio.
AUDIO_DIR=/audio

# Mac Studio (LM Studio) over Tailscale.
TRANSCRIBE_URL=http://100.121.55.88:8000/v1/audio/transcriptions

# Same machine, Ollama / MLX chat (enhance.py).
LLM_URL=http://100.121.55.88:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=ollama

# Aria intake. Enhancer POSTs here after a summary is done.
# From Docker use host.docker.internal (Aria listens on the host).
ARIA_INTAKE_URL=http://100.74.101.82:8787/skills/field-notes/ready
ARIA_SKILLS_KEY=
